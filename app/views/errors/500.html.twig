{% extends "layouts/error.html.twig" %}

{% block title %}500 - Serverfout{% endblock %}

{% block content %}
    <div class="text-center px-8">

        <h1 class="text-9xl font-extrabold text-red-500">500</h1>

        <div class="w-24 h-1 bg-red-500 mx-auto my-6 rounded"></div>

        <h2 class="text-2xl font-semibold">
            Er is iets misgegaan
        </h2>

        <p class="text-gray-400 mt-4 max-w-md mx-auto">
            Er is een onverwachte fout opgetreden aan onze kant.
            Probeer de pagina opnieuw te laden, of ga terug naar de homepagina.
            Als het probleem aanhoudt, neem dan contact op.
        </p>

        <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 2.5rem; flex-wrap: wrap;">
            <a href="javascript:location.reload()"
               class="inline-block bg-red-600 hover:bg-red-700
                          text-white px-8 py-3 rounded-lg shadow-lg
                          transition duration-300">
                Opnieuw proberen
            </a>
            <a href="/"
               class="inline-block bg-gray-200 hover:bg-gray-300
                          text-gray-700 px-8 py-3 rounded-lg shadow-lg
                          transition duration-300">
                Naar homepagina
            </a>
        </div>

    </div>

{% endblock %}
