{% extends "layouts/error.html.twig" %}

{% block title %}500 — Serverfout{% endblock %}

{% block content %}

    <!-- Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-red-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative">
        <p class="font-mono-custom text-xs text-slate-600 uppercase tracking-widest mb-4">// internal server error</p>

        <h1 class="text-8xl md:text-9xl font-bold font-mono-custom text-transparent bg-clip-text bg-gradient-to-br from-red-400 to-rose-700 leading-none mb-2">
            500
        </h1>

        <div class="w-12 h-px bg-gradient-to-r from-red-500 to-rose-600 mx-auto my-6"></div>

        <h2 class="text-xl font-semibold text-slate-100 mb-3">Er is iets misgegaan</h2>

        <p class="text-slate-400 text-sm leading-relaxed max-w-sm mx-auto">
            Er is een onverwachte fout opgetreden aan onze kant.
            Probeer de pagina opnieuw te laden, of ga terug naar de homepagina.
            Als het probleem aanhoudt, neem dan contact op.
        </p>

        <div class="flex gap-3 justify-center mt-8 flex-wrap">
            <a href="javascript:location.reload()"
               class="px-5 py-2.5 bg-red-600 hover:bg-red-500 text-white font-semibold rounded-lg text-sm transition-colors font-mono-custom">
                Opnieuw proberen
            </a>
            <a href="/"
               class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-medium rounded-lg text-sm transition-colors">
                Naar homepagina
            </a>
        </div>
    </div>

{% endblock %}
