{% extends "layouts/error.html.twig" %}

{% block title %}403 - Geen toegang{% endblock %}

{% block content %}
    <div class="text-center px-8">

        <h1 class="text-9xl font-extrabold text-blue-500">403</h1>

        <div class="w-24 h-1 bg-blue-500 mx-auto my-6 rounded"></div>

        <h2 class="text-2xl font-semibold">
            Geen toegang
        </h2>

        <p class="text-gray-400 mt-4 max-w-md mx-auto">
            Je hebt geen toegang tot deze pagina.
            Log in met een account dat de juiste rechten heeft, of ga terug naar de homepagina.
        </p>

        <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 2.5rem; flex-wrap: wrap;">
            <a href="/login"
               class="inline-block bg-blue-600 hover:bg-blue-700
                          text-white px-8 py-3 rounded-lg shadow-lg
                          transition duration-300">
                Inloggen
            </a>
            <a href="/"
               class="inline-block bg-gray-200 hover:bg-gray-300
                          text-gray-700 px-8 py-3 rounded-lg shadow-lg
                          transition duration-300">
                Naar homepagina
            </a>
        </div>

    </div>

{% endblock %}
