{% extends "layouts/error.html.twig" %}

{% block title %}404 — Pagina niet gevonden{% endblock %}

{% block content %}

    <!-- Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-cyan-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative">
        <p class="font-mono-custom text-xs text-slate-600 uppercase tracking-widest mb-4">// error</p>

        <h1 class="text-8xl md:text-9xl font-bold font-mono-custom text-transparent bg-clip-text bg-gradient-to-br from-cyan-400 to-blue-600 leading-none mb-2">
            404
        </h1>

        <div class="w-12 h-px bg-gradient-to-r from-cyan-500 to-blue-500 mx-auto my-6"></div>

        <h2 class="text-xl font-semibold text-slate-100 mb-3">Pagina niet gevonden</h2>

        <p class="text-slate-400 text-sm leading-relaxed max-w-sm mx-auto">
            De pagina die je zoekt bestaat niet of is verplaatst.
            Controleer of het adres klopt, of ga terug naar de homepagina.
        </p>

        <div class="flex gap-3 justify-center mt-8 flex-wrap">
            <a href="/"
               class="px-5 py-2.5 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold rounded-lg text-sm transition-colors font-mono-custom">
                Naar homepagina
            </a>
            <a href="javascript:history.back()"
               class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-medium rounded-lg text-sm transition-colors">
                Ga terug
            </a>
        </div>
    </div>

{% endblock %}
