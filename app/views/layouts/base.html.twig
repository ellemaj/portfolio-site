<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="author" content="Elmar van Loenhout">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">

    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico">

    {% block styles %}{% endblock %}
    {% block scripts %}{% endblock %}

    <title> {% block title %}{% endblock %}</title>
</head>

<body>

    <header>
        <a href="/"><img src="/assets/images/logo.png" width="10%" alt="Logo"></a>
    </header>

    <nav class="menu">
        <ul>
            <li><a href="/" class="{% if active == 'home' %}active{% endif %}">Home</a></li>
            <li><a href="/profile" class="{% if active == 'profile' %}active{% endif %}">Profile</a></li>
            <li><a href="/dashboard" class="{% if active == 'dashboard' %}active{% endif %}">Dashboard</a></li>
            <li><a href="/faq" class="{% if active == 'faq' %}active{% endif %}">FAQ</a></li>
            <li><a href="/blog" class="{% if active == 'blog' %}active{% endif %}">Blog</a></li>

            {% if session.user_id %}
                <li><a href="/overview" class="{% if active == 'overview' %}active{% endif %}">Overview</a></li>

                {% if session.role == 'admin' %}
                    <li><a href="/blog/manage" class="{% if active == 'manage' %}active{% endif %}">Blog beheren</a></li>
                    <li><a href="/profile/edit" class="{% if active == 'editProfile' %}active{% endif %}">Edit profile</a></li>
                {% endif %}

                <li>
                    <a href="/logout">Logout</a>
                </li>
            {% else %}
                <li><a href="/login" class="{% if active == 'login' %}active{% endif %}">Login</a></li>
            {% endif %}
        </ul>
    </nav>

    <!-- Content -->
    <main>
        {% block content %}{% endblock %}
        {% include 'layouts/toasts.html.twig' %}
    </main>

    <!-- Footer -->
    <footer>
        <a href="/">© {{ "now"|date("Y") }} ellemaj</a> |
        <a href="mailto:loen0029@hz.nl">Contact</a> |
        <a href="commandmaker" class="{% if active == 'commandmaker' %}active{% endif %}">Commandmaker</a>
    </footer>

    <!-- Confirm dialog -->
    <dialog id="confirm-dialog">
        <p id="confirm-message">Weet je zeker dat je dit wilt verwijderen?</p>
        <div class="confirm-buttons">
            <button id="confirm-yes">Verwijderen</button>
            <button id="confirm-no">Annuleren</button>
        </div>
    </dialog>

    <style>
        #confirm-dialog {
            border: none;
            border-radius: 6px;
            padding: 2rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            min-width: 300px;
        }

        #confirm-dialog::backdrop {
            background: rgba(0,0,0,0.5);
        }

        .confirm-buttons {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
            justify-content: flex-end;
        }

        #confirm-yes {
            background: #c2004b;
            color: white;
            border: none;
            padding: 0.5rem 1.25rem;
            border-radius: 4px;
            cursor: pointer;
        }

        #confirm-no {
            background: #eee;
            color: #333;
            border: none;
            padding: 0.5rem 1.25rem;
            border-radius: 4px;
            cursor: pointer;
        }
    </style>

    <script>
        const dialog = document.getElementById('confirm-dialog');
        const confirmYes = document.getElementById('confirm-yes');
        const confirmNo = document.getElementById('confirm-no');

        let pendingForm = null;

        // Intercept all delete forms
        document.querySelectorAll('[data-confirm]').forEach(form => {
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                pendingForm = form;
                document.getElementById('confirm-message').textContent =
                    form.dataset.confirm || 'Weet je zeker dat je dit wilt verwijderen?';
                dialog.showModal();
            });
        });

        confirmYes.addEventListener('click', () => {
            dialog.close();
            if (pendingForm) {
                pendingForm.removeEventListener('submit', () => {});
                pendingForm.submit();
            }
        });

        confirmNo.addEventListener('click', () => {
            dialog.close();
            pendingForm = null;
        });
    </script>
</body>
</html>
