<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="author" content="Elmar van Loenhout">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="description" content="{% block meta_description %}Portfolio van Elmar van Loenhout (ellemaj): projecten, blog en profiel als ICT-student en audiovisuele technicus.{% endblock %}">
    {% if canonical_url is defined and canonical_url %}
        <link rel="canonical" href="{{ canonical_url }}">
    {% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/assets/css/app.css">
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico">

    {% block styles %}{% endblock %}
    {% block scripts %}{% endblock %}

    <title>{% block title %}{% endblock %} - ellemaj</title>


</head>

<body class="bg-slate-900 text-slate-200 min-h-screen flex flex-col">

    <!-- Animated background orbs -->
    <div class="bg-orbs" aria-hidden="true">
        <div class="bg-orb bg-orb-1"></div>
        <div class="bg-orb bg-orb-2"></div>
        <div class="bg-orb bg-orb-3"></div>
    </div>

    <div id="page-loading-bar" aria-hidden="true"></div>

    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-slate-950/90 backdrop-blur-md border-b border-slate-800/60">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-14">

                <!-- Brand -->
                <a href="/" class="flex items-center group">
                    <span class="font-mono-custom font-semibold text-sm">
                        <span class="text-slate-600">&lt;</span><span class="text-cyan-400 group-hover:text-cyan-300 transition-colors">ellemaj</span><span class="text-slate-600">/&gt;</span>
                    </span>
                </a>

                <!-- Desktop links -->
                <div class="hidden md:flex items-center gap-0.5">
                    <a href="/" class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors {% if active == 'home' %}text-cyan-400 bg-cyan-400/10 nav-active-glow{% else %}text-slate-400 hover:text-slate-100 hover:bg-slate-800/60{% endif %}">Home</a>
                    <a href="/profile" class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors {% if active == 'profile' %}text-cyan-400 bg-cyan-400/10 nav-active-glow{% else %}text-slate-400 hover:text-slate-100 hover:bg-slate-800/60{% endif %}">Profile</a>
                    <a href="/dashboard" class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors {% if active == 'dashboard' %}text-cyan-400 bg-cyan-400/10 nav-active-glow{% else %}text-slate-400 hover:text-slate-100 hover:bg-slate-800/60{% endif %}">Dashboard</a>
                    <a href="/faq" class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors {% if active == 'faq' %}text-cyan-400 bg-cyan-400/10 nav-active-glow{% else %}text-slate-400 hover:text-slate-100 hover:bg-slate-800/60{% endif %}">FAQ</a>
                    <a href="/blog" class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors {% if active == 'blog' %}text-cyan-400 bg-cyan-400/10 nav-active-glow{% else %}text-slate-400 hover:text-slate-100 hover:bg-slate-800/60{% endif %}">Blog</a>

                    {% if session.user_id %}
                        <a href="/overview" class="px-3 py-1.5 rounded-md text-sm font-medium transition-colors {% if active == 'overview' %}text-cyan-400 bg-cyan-400/10 nav-active-glow{% else %}text-slate-400 hover:text-slate-100 hover:bg-slate-800/60{% endif %}">Overview</a>
                        {% if session.role == 'admin' %}
                            <details class="group relative" data-dropdown>
                                <summary class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-medium cursor-pointer list-none select-none transition-colors {% if active in ['manage', 'manageProjects', 'editProfile'] %}text-amber-400 bg-amber-400/10{% else %}text-slate-500 hover:text-amber-400 hover:bg-slate-800/60{% endif %}">
                                    <span class="font-mono-custom text-xs">⚙</span> Manage
                                    <svg class="w-3.5 h-3.5 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                    </svg>
                                </summary>
                                <div class="absolute right-0 z-10 mt-1.5 w-40 bg-slate-900 border border-slate-800 rounded-lg shadow-xl overflow-hidden">
                                    <a href="/blog/manage" class="block px-4 py-2 text-sm font-medium transition-colors {% if active == 'manage' %}text-amber-400 bg-amber-400/10{% else %}text-slate-400 hover:text-amber-400 hover:bg-slate-800/60{% endif %}">Blog</a>
                                    <a href="/projects/manage" class="block px-4 py-2 text-sm font-medium transition-colors {% if active == 'manageProjects' %}text-amber-400 bg-amber-400/10{% else %}text-slate-400 hover:text-amber-400 hover:bg-slate-800/60{% endif %}">Projects</a>
                                    <a href="/profile/edit" class="block px-4 py-2 text-sm font-medium transition-colors {% if active == 'editProfile' %}text-amber-400 bg-amber-400/10{% else %}text-slate-400 hover:text-amber-400 hover:bg-slate-800/60{% endif %}">Profile</a>
                                </div>
                            </details>
                        {% endif %}
                        <a href="/logout" class="ml-1 px-3 py-1.5 rounded-md text-sm font-medium text-slate-500 hover:text-red-400 hover:bg-red-400/10 transition-colors">Logout</a>
                    {% else %}
                        <a href="/login" class="ml-2 px-4 py-1.5 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold rounded-md text-sm transition-colors font-mono-custom tracking-tight">Login</a>
                    {% endif %}
                </div>

                <!-- Mobile menu button -->
                <button id="mobile-menu-btn" class="md:hidden p-2 rounded-md text-slate-400 hover:text-slate-200 hover:bg-slate-800 transition-colors" aria-label="Toggle menu">
                    <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                    <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile menu -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-slate-800 bg-slate-950/95">
            <div class="px-4 py-3 flex flex-col gap-1">
                <a href="/" class="px-3 py-2.5 rounded-md text-sm font-medium transition-colors {% if active == 'home' %}text-cyan-400 bg-cyan-400/10{% else %}text-slate-400 hover:text-slate-100 hover:bg-slate-800/60{% endif %}">Home</a>
                <a href="/profile" class="px-3 py-2.5 rounded-md text-sm font-medium transition-colors {% if active == 'profile' %}text-cyan-400 bg-cyan-400/10{% else %}text-slate-400 hover:text-slate-100 hover:bg-slate-800/60{% endif %}">Profile</a>
                <a href="/dashboard" class="px-3 py-2.5 rounded-md text-sm font-medium transition-colors {% if active == 'dashboard' %}text-cyan-400 bg-cyan-400/10{% else %}text-slate-400 hover:text-slate-100 hover:bg-slate-800/60{% endif %}">Dashboard</a>
                <a href="/faq" class="px-3 py-2.5 rounded-md text-sm font-medium transition-colors {% if active == 'faq' %}text-cyan-400 bg-cyan-400/10{% else %}text-slate-400 hover:text-slate-100 hover:bg-slate-800/60{% endif %}">FAQ</a>
                <a href="/blog" class="px-3 py-2.5 rounded-md text-sm font-medium transition-colors {% if active == 'blog' %}text-cyan-400 bg-cyan-400/10{% else %}text-slate-400 hover:text-slate-100 hover:bg-slate-800/60{% endif %}">Blog</a>
                {% if session.user_id %}
                    <a href="/overview" class="px-3 py-2.5 rounded-md text-sm font-medium transition-colors {% if active == 'overview' %}text-cyan-400 bg-cyan-400/10{% else %}text-slate-400 hover:text-slate-100 hover:bg-slate-800/60{% endif %}">Overview</a>
                    {% if session.role == 'admin' %}
                        <a href="/blog/manage" class="px-3 py-2.5 rounded-md text-sm font-medium text-slate-400 hover:text-amber-400 hover:bg-slate-800/60 transition-colors">Manage Blog</a>
                        <a href="/projects/manage" class="px-3 py-2.5 rounded-md text-sm font-medium text-slate-400 hover:text-amber-400 hover:bg-slate-800/60 transition-colors">Manage Projects</a>
                        <a href="/profile/edit" class="px-3 py-2.5 rounded-md text-sm font-medium text-slate-400 hover:text-amber-400 hover:bg-slate-800/60 transition-colors">Edit Profile</a>
                    {% endif %}
                    <a href="/logout" class="px-3 py-2.5 rounded-md text-sm font-medium text-slate-400 hover:text-red-400 hover:bg-red-400/10 transition-colors">Logout</a>
                {% else %}
                    <a href="/login" class="px-3 py-2.5 rounded-md text-sm font-medium text-cyan-400 hover:bg-cyan-400/10 transition-colors">Login</a>
                {% endif %}
            </div>
        </div>
    </nav>

    <!-- Main content -->
    <main class="flex-1 pt-14 relative z-10">
        {% block content %}{% endblock %}
        {% include 'layouts/toasts.html.twig' %}
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/60 bg-slate-950/80 py-6 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3">
            <span class="font-mono-custom text-slate-500 text-sm">
                <span class="text-slate-700">&lt;</span><span class="text-slate-400">ellemaj</span><span class="text-slate-700">/&gt;</span>
                <span class="text-slate-700 ml-2">© {{ "now"|date("Y") }}</span>
            </span>
            <div class="flex items-center gap-4 text-sm">
                <a href="mailto:elmarvloenhout@gmail.com" class="text-slate-500 hover:text-cyan-400 transition-colors">Contact</a>
                <span class="text-slate-800">|</span>
                <a href="/commandmaker" class="text-slate-500 hover:text-cyan-400 transition-colors {% if active == 'commandmaker' %}text-cyan-400{% endif %}">Commandmaker</a>
                <span class="text-slate-800">|</span>
                <a href="/sitemap" class="text-slate-500 hover:text-cyan-400 transition-colors {% if active == 'sitemap' %}text-cyan-400{% endif %}">Sitemap</a>
            </div>
        </div>
    </footer>

    <!-- Confirm dialog -->
    <dialog id="confirm-dialog" class="rounded-xl border border-slate-700 bg-slate-900 text-slate-200 p-0 shadow-2xl w-full max-w-sm">
        <div class="p-6">
            <div class="flex items-start gap-3 mb-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-red-500/10 flex items-center justify-center">
                    <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                </div>
                <p id="confirm-message" class="text-slate-200 font-medium pt-1.5 leading-snug">Weet je zeker dat je dit wilt verwijderen?</p>
            </div>
            <div class="flex gap-3 justify-end">
                <button id="confirm-no" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 rounded-lg text-sm font-medium transition-colors cursor-pointer">Annuleren</button>
                <button id="confirm-yes" class="px-4 py-2 bg-red-600 hover:bg-red-500 text-white rounded-lg text-sm font-semibold transition-colors cursor-pointer">Verwijderen</button>
            </div>
        </div>
    </dialog>

    <script src="/assets/js/layout.js"></script>
</body>
</html>
