{% if toasts is defined and toasts|length > 0 %}
<div id="toast-viewport" style="position:fixed;top:4.5rem;right:1.25rem;display:flex;flex-direction:column;align-items:flex-end;gap:0.625rem;z-index:9999;">
    {% for toast in toasts %}
        <div class="toast toast-{{ toast.type|default('info') }}" role="alert" data-toast
             style="display:flex;flex-direction:column;min-width:300px;max-width:420px;border-radius:0.75rem;overflow:hidden;opacity:0;transform:translateX(12px);transition:opacity 0.25s ease,transform 0.25s ease;position:relative;">

            <div style="display:flex;align-items:center;gap:0.625rem;padding:0.875rem 1rem;">
                <!-- Icon -->
                <div class="toast-icon" style="flex-shrink:0;width:18px;height:18px;">
                    {% if toast.type == 'success' %}
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                    {% elseif toast.type == 'error' %}
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                    {% else %}
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {% endif %}
                </div>
                <!-- Message -->
                <span style="flex:1;font-size:0.8125rem;font-weight:500;line-height:1.4;">{{ toast.message }}</span>
                <!-- Close -->
                <button type="button" class="toast-close" aria-label="Sluiten"
                        style="background:none;border:none;cursor:pointer;padding:0 0.25rem;font-size:1.1rem;line-height:1;opacity:0.5;transition:opacity 0.15s;"
                        onmouseenter="this.style.opacity='1'" onmouseleave="this.style.opacity='0.5'">✕</button>
            </div>

            <!-- Progress bar -->
            <div class="toast-progress" style="height:2px;width:100%;"></div>
        </div>
    {% endfor %}
</div>

<style>
    /* Toast type theming */
    .toast-success {
        background: #0f2818;
        border: 1px solid rgba(52, 211, 153, 0.25);
        color: #6ee7b7;
    }
    .toast-success .toast-icon { color: #34d399; }
    .toast-success .toast-progress { background: rgba(52, 211, 153, 0.15); }
    .toast-success .toast-progress::after { background: #34d399; }

    .toast-error {
        background: #2a0f0f;
        border: 1px solid rgba(248, 113, 113, 0.25);
        color: #fca5a5;
    }
    .toast-error .toast-icon { color: #f87171; }
    .toast-error .toast-progress { background: rgba(248, 113, 113, 0.15); }
    .toast-error .toast-progress::after { background: #f87171; }

    .toast-info {
        background: #0c1a2e;
        border: 1px solid rgba(34, 211, 238, 0.25);
        color: #7dd3fc;
    }
    .toast-info .toast-icon { color: #22d3ee; }
    .toast-info .toast-progress { background: rgba(34, 211, 238, 0.15); }
    .toast-info .toast-progress::after { background: #22d3ee; }

    /* Progress bar fill */
    .toast-progress { position: relative; overflow: hidden; }
    .toast-progress::after {
        content: '';
        position: absolute;
        inset: 0;
        transform-origin: left;
        transform: scaleX(1);
    }
    .toast.active .toast-progress::after {
        animation: toast-shrink 6s linear forwards;
    }
    @keyframes toast-shrink {
        from { transform: scaleX(1); }
        to   { transform: scaleX(0); }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('[data-toast]').forEach((toast, i) => {
            setTimeout(() => {
                toast.style.opacity = '1';
                toast.style.transform = 'translateX(0)';
                toast.classList.add('active');
            }, i * 120);

            const timer = setTimeout(() => removeToast(toast), 6000);

            toast.querySelector('.toast-close').addEventListener('click', () => {
                clearTimeout(timer);
                removeToast(toast);
            });
        });

        function removeToast(toast) {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(12px)';
            setTimeout(() => toast.remove(), 280);
        }
    });
</script>
{% endif %}
