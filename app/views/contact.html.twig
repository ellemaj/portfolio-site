{% extends "layouts/base.html.twig" %}

{% block title %}Contact{% endblock %}
{% block meta_description %}Neem contact op met Elmar van Loenhout via het contactformulier of via GitHub, LinkedIn en Discord.{% endblock %}

{% block scripts %}
    <script src="/assets/js/contact.js" defer></script>
{% endblock %}

{% block content %}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Page header -->
    <div class="mb-8">
        <div class="font-mono-custom text-xs text-cyan-500 tracking-widest uppercase flex items-center gap-2 mb-2">
            <span class="inline-block w-6 h-px bg-cyan-500/50"></span>
            <span>Contact</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-slate-100">Neem contact op</h1>
        <p class="mt-2 text-slate-400 text-sm max-w-lg">
            Heb je een vraag of wil je iets bespreken? Stuur een bericht via het formulier of via een van de links hiernaast.
        </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <!-- Form -->
        <div class="lg:col-span-2 bg-slate-800/50 border border-slate-700/60 rounded-2xl p-7">
            <form method="POST" action="/contact" id="contact-form" novalidate class="space-y-4">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

                <!-- Honeypot: hidden from real visitors, bots tend to fill every field -->
                <div style="position:absolute;left:-9999px;" aria-hidden="true">
                    <label for="website">Website</label>
                    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
                </div>

                <!-- Name -->
                <div>
                    <label for="name" class="block text-xs font-mono-custom text-slate-400 uppercase tracking-wider mb-1.5">Naam</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        placeholder="Je naam"
                        autocomplete="name"
                        required
                        class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 placeholder-slate-600 rounded-lg text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors"
                    >
                    <p class="field-error hidden mt-1.5 text-xs text-red-400 font-mono-custom" id="name-error">Vul je naam in.</p>
                </div>

                <!-- Email -->
                <div>
                    <label for="email" class="block text-xs font-mono-custom text-slate-400 uppercase tracking-wider mb-1.5">Email</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="voorbeeld@email.nl"
                        autocomplete="email"
                        required
                        class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 placeholder-slate-600 rounded-lg text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors"
                    >
                    <p class="field-error hidden mt-1.5 text-xs text-red-400 font-mono-custom" id="email-error">Voer een geldig e-mailadres in.</p>
                </div>

                <!-- Message -->
                <div>
                    <label for="message" class="block text-xs font-mono-custom text-slate-400 uppercase tracking-wider mb-1.5">Bericht</label>
                    <textarea
                        id="message"
                        name="message"
                        rows="5"
                        placeholder="Waar gaat het over?"
                        required
                        class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 placeholder-slate-600 rounded-lg text-sm resize-y focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors"
                    ></textarea>
                    <p class="field-error hidden mt-1.5 text-xs text-red-400 font-mono-custom" id="message-error">Vul een bericht in.</p>
                </div>

                <!-- Submit -->
                <button
                    type="submit"
                    class="w-full mt-2 px-4 py-2.5 bg-cyan-500 hover:bg-cyan-400 disabled:opacity-50 text-slate-950 font-semibold rounded-lg text-sm transition-colors font-mono-custom"
                >
                    Versturen →
                </button>
            </form>
        </div>

        <!-- Direct links -->
        <div class="bg-slate-800/40 border border-slate-700/60 rounded-xl p-4 space-y-2 h-fit">
            <p class="font-mono-custom text-xs text-slate-500 uppercase tracking-widest mb-3">Of direct via</p>

            {% if profile and profile.github %}
                <a href="{{ profile.github }}" target="_blank" rel="noopener"
                   class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-slate-100 hover:bg-slate-700/60 transition-colors group">
                    <svg class="w-4 h-4 flex-shrink-0 group-hover:text-slate-200" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                    </svg>
                    GitHub
                </a>
            {% endif %}
            {% if profile and profile.linkedin %}
                <a href="{{ profile.linkedin }}" target="_blank" rel="noopener"
                   class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-slate-100 hover:bg-slate-700/60 transition-colors group">
                    <svg class="w-4 h-4 flex-shrink-0 text-blue-400 group-hover:text-blue-300" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                    LinkedIn
                </a>
            {% endif %}
            {% if profile and profile.discord %}
                <a href="{{ profile.discord }}" target="_blank" rel="noopener"
                   class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-slate-100 hover:bg-slate-700/60 transition-colors group">
                    <svg class="w-4 h-4 flex-shrink-0 text-indigo-400 group-hover:text-indigo-300" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.033.055a19.84 19.84 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03z"/>
                    </svg>
                    Discord
                </a>
            {% endif %}

            <a href="mailto:elmarvloenhout@gmail.com"
               class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-slate-100 hover:bg-slate-700/60 transition-colors group">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                Email
            </a>
        </div>

    </div>
</div>

{% endblock %}
