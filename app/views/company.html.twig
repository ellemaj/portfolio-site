{% extends "layouts/base.html.twig" %}

{% block title %}EvL Tech{% endblock %}
{% block meta_description %}EvL Tech: het bedrijf van Elmar van Loenhout.{% endblock %}

{% block content %}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Page header -->
    <div class="mb-8 flex items-start justify-between gap-4">
        <div>
            <div class="font-mono-custom text-xs text-cyan-500 tracking-widest uppercase flex items-center gap-2 mb-2">
                <span class="inline-block w-6 h-px bg-cyan-500/50"></span>
                <span>Bedrijf</span>
            </div>
            <h1 class="text-3xl md:text-4xl font-bold text-slate-100">{{ company.name }}</h1>
        </div>
        {% if is_admin %}
            <a href="/evl-tech/edit" class="mt-1 font-mono-custom text-xs text-amber-500 hover:text-amber-400 transition-colors">✎ Bewerken</a>
        {% endif %}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <!-- Left column: logo -->
        <div class="space-y-4">
            <div class="aspect-square flex items-center justify-center rounded-xl bg-slate-800/40 p-8">
                <img src="{{ company.logo }}" alt="{{ company.name }} logo" class="w-full h-full object-contain">
            </div>
        </div>

        <!-- Right column: content -->
        <div class="lg:col-span-2 space-y-6">

            <!-- About -->
            <div class="bg-slate-800/40 border border-slate-700/60 rounded-xl p-6">
                <h2 class="font-mono-custom text-xs text-cyan-500 uppercase tracking-widest mb-3">Over {{ company.name }}</h2>
                <p class="text-slate-300 leading-relaxed">{{ company.description|raw }}</p>
            </div>

            <!-- Services -->
            <div class="bg-slate-800/40 border border-slate-700/60 rounded-xl p-6">
                <h2 class="font-mono-custom text-xs text-cyan-500 uppercase tracking-widest mb-4">Diensten</h2>
                <div class="grid sm:grid-cols-3 gap-4">
                    <div class="bg-slate-900/50 border border-slate-700/40 rounded-lg p-4">
                        <p class="text-slate-100 font-medium text-sm mb-1.5">{{ company.service1_title }}</p>
                        <p class="text-slate-400 text-xs leading-relaxed">{{ company.service1_description }}</p>
                    </div>
                    <div class="bg-slate-900/50 border border-slate-700/40 rounded-lg p-4">
                        <p class="text-slate-100 font-medium text-sm mb-1.5">{{ company.service2_title }}</p>
                        <p class="text-slate-400 text-xs leading-relaxed">{{ company.service2_description }}</p>
                    </div>
                    <div class="bg-slate-900/50 border border-slate-700/40 rounded-lg p-4">
                        <p class="text-slate-100 font-medium text-sm mb-1.5">{{ company.service3_title }}</p>
                        <p class="text-slate-400 text-xs leading-relaxed">{{ company.service3_description }}</p>
                    </div>
                </div>
            </div>

            <!-- Photos -->
            <div class="bg-slate-800/40 border border-slate-700/60 rounded-xl p-6">
                <h2 class="font-mono-custom text-xs text-cyan-500 uppercase tracking-widest mb-4">Foto's</h2>
                <div class="grid sm:grid-cols-2 gap-4">
                    <img src="{{ company.photo1 }}" alt="{{ company.name }} foto 1" class="w-full rounded-lg">
                    <img src="{{ company.photo2 }}" alt="{{ company.name }} foto 2" class="w-full rounded-lg">
                </div>
            </div>

        </div>
    </div>
</div>

{% endblock %}
