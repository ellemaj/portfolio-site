{% extends "layouts/base.html.twig" %}

{% block title %}Profile{% endblock %}

{% block content %}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Page header -->
    <div class="mb-8">
        <div class="font-mono-custom text-xs text-cyan-500 tracking-widest uppercase flex items-center gap-2 mb-2">
            <span class="inline-block w-6 h-px bg-cyan-500/50"></span>
            <span>Portfolio</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-slate-100">About Me</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <!-- Left column: photo + links -->
        <div class="space-y-4">
            {% if profile.image %}
                <div class="relative group">
                    <div class="absolute -inset-1 bg-gradient-to-br from-cyan-500/20 to-blue-600/20 rounded-2xl blur opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                    <img src="{{ profile.image }}" alt="Profile image" class="profile-image relative">
                </div>
            {% endif %}

            <!-- Links card -->
            <div class="bg-slate-800/40 border border-slate-700/60 rounded-xl p-4 space-y-2">
                <p class="font-mono-custom text-xs text-slate-500 uppercase tracking-widest mb-3">Links</p>
                {% if profile.github %}
                    <a href="{{ profile.github }}" target="_blank" rel="noopener"
                       class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-slate-100 hover:bg-slate-700/60 transition-colors group">
                        <svg class="w-4 h-4 flex-shrink-0 group-hover:text-slate-200" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                        </svg>
                        GitHub
                    </a>
                {% endif %}
                {% if profile.linkedin %}
                    <a href="{{ profile.linkedin }}" target="_blank" rel="noopener"
                       class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-slate-100 hover:bg-slate-700/60 transition-colors group">
                        <svg class="w-4 h-4 flex-shrink-0 text-blue-400 group-hover:text-blue-300" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                        </svg>
                        LinkedIn
                    </a>
                {% endif %}
                {% if profile.spotify %}
                    <a href="{{ profile.spotify }}" target="_blank" rel="noopener"
                       class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-slate-100 hover:bg-slate-700/60 transition-colors group">
                        <svg class="w-4 h-4 flex-shrink-0 text-green-400 group-hover:text-green-300" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
                        </svg>
                        Spotify
                    </a>
                {% endif %}
                {% if profile.discord %}
                    <a href="{{ profile.discord }}" target="_blank" rel="noopener"
                       class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-slate-100 hover:bg-slate-700/60 transition-colors group">
                        <svg class="w-4 h-4 flex-shrink-0 text-indigo-400 group-hover:text-indigo-300" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.033.055a19.84 19.84 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03z"/>
                        </svg>
                        Discord
                    </a>
                {% endif %}
            </div>
        </div>

        <!-- Right column: content -->
        <div class="lg:col-span-2 space-y-6">

            <!-- Bio -->
            <div class="bg-slate-800/40 border border-slate-700/60 rounded-xl p-6">
                <h2 class="font-mono-custom text-xs text-cyan-500 uppercase tracking-widest mb-3">Biography</h2>
                <p class="text-slate-300 leading-relaxed">{{ profile.bio }}</p>
            </div>

            <!-- Education + Experience grid -->
            <div class="grid sm:grid-cols-2 gap-4">
                <div class="bg-slate-800/40 border border-slate-700/60 rounded-xl p-6">
                    <h2 class="font-mono-custom text-xs text-cyan-500 uppercase tracking-widest mb-3">Education</h2>
                    <p class="text-slate-300 leading-relaxed text-sm">{{ profile.education }}</p>
                </div>
                <div class="bg-slate-800/40 border border-slate-700/60 rounded-xl p-6">
                    <h2 class="font-mono-custom text-xs text-cyan-500 uppercase tracking-widest mb-3">Experience</h2>
                    <p class="text-slate-300 leading-relaxed text-sm">{{ profile.experience }}</p>
                </div>
            </div>

            <!-- Skills -->
            <div class="bg-slate-800/40 border border-slate-700/60 rounded-xl p-6">
                <h2 class="font-mono-custom text-xs text-cyan-500 uppercase tracking-widest mb-4">Technical Skills</h2>
                <div class="flex flex-wrap gap-2">
                    {% for skill in skills %}
                        <span class="px-3 py-1.5 bg-slate-700/60 border border-slate-600/60 text-slate-300 text-xs font-mono-custom rounded-md hover:border-cyan-500/40 hover:text-cyan-400 transition-colors">
                            {{ skill }}
                        </span>
                    {% endfor %}
                </div>
            </div>

            <!-- Personal Traits -->
            <div class="bg-slate-800/40 border border-slate-700/60 rounded-xl p-6">
                <h2 class="font-mono-custom text-xs text-cyan-500 uppercase tracking-widest mb-4">Personal Traits</h2>
                <ul class="space-y-2">
                    {% for trait in traits %}
                        <li class="flex items-center gap-2.5 text-slate-300 text-sm">
                            <span class="flex-shrink-0 w-1.5 h-1.5 rounded-full bg-cyan-500"></span>
                            {{ trait }}
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <!-- Projects -->
            {% if projects|length > 0 %}
            <div class="bg-slate-800/40 border border-slate-700/60 rounded-xl p-6">
                <h2 class="font-mono-custom text-xs text-cyan-500 uppercase tracking-widest mb-4">Projects</h2>
                <div class="space-y-3">
                    {% for project in projects %}
                    <div class="flex items-start justify-between gap-4 p-4 bg-slate-900/50 border border-slate-700/40 rounded-lg hover:border-cyan-500/30 transition-colors">
                        <div class="min-w-0">
                            <p class="text-slate-100 font-medium text-sm">{{ project.name }}</p>
                            <p class="text-slate-400 text-xs mt-1 leading-relaxed">{{ project.description }}</p>
                        </div>
                        {% if project.url %}
                        <a href="{{ project.url }}" target="_blank" rel="noopener"
                           class="flex-shrink-0 flex items-center gap-1.5 px-3 py-1.5 bg-slate-700/60 hover:bg-cyan-500/10 border border-slate-600/60 hover:border-cyan-500/40 text-slate-400 hover:text-cyan-400 rounded-md text-xs font-mono-custom transition-colors">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                            </svg>
                            Visit
                        </a>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

        </div>
    </div>
</div>

{% endblock %}
