{% extends "layouts/base.html.twig" %}

{% block title %}Home{% endblock %}
{% block meta_description %}Portfolio van Elmar van Loenhout: ICT-student en audiovisueel technicus met projecten, blog en biografie op één plek.{% endblock %}

{% block content %}

<!-- Hero -->
<section class="relative overflow-hidden py-24 md:py-36">

    <!-- Dot grid background -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, #94a3b8 1px, transparent 1px); background-size: 28px 28px;"></div>

    <!-- Gradient glow -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-3 font-mono-custom text-xs text-cyan-500 tracking-widest uppercase flex items-center gap-2">
            <span class="inline-block w-8 h-px bg-cyan-500/50"></span>
            <span>About me</span>
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-slate-100 mb-5 leading-tight tracking-tight">
            Hoi, ik ben <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Elmar</span>
        </h1>
        <p class="text-lg md:text-xl text-slate-400 max-w-2xl leading-relaxed">
            HBO-ICT student aan de HZ University of Applied Sciences met interesse in webontwikkeling en evenemententechnologie.
        </p>

        <div class="flex flex-wrap gap-3 mt-8">
            <a href="/profile" class="px-5 py-2.5 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold rounded-lg text-sm transition-colors font-mono-custom">
                View Profile →
            </a>
            <a href="/blog" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-medium rounded-lg text-sm transition-colors">
                Read Blog
            </a>
        </div>
    </div>
</section>

<!-- Content -->
<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
    <div class="bg-slate-800/40 border border-slate-700/60 rounded-2xl overflow-hidden">

        <!-- Card header -->
        <div class="px-6 py-4 border-b border-slate-700/60 flex items-center gap-3">
            <div class="flex gap-1.5">
                <span class="w-3 h-3 rounded-full bg-red-500/60"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-500/60"></span>
                <span class="w-3 h-3 rounded-full bg-green-500/60"></span>
            </div>
            <span class="font-mono-custom text-xs text-slate-500">~/portfolio/about.md</span>
        </div>

        <div class="p-6 md:p-8">
            <div class="flex items-center gap-2 mb-6">
                <span class="font-mono-custom text-cyan-500 text-sm">##</span>
                <h2 class="text-xl font-semibold text-slate-100">HBO-ICT</h2>
            </div>

            <div class="grid md:grid-cols-2 gap-8 items-start">
                <div class="space-y-4 text-slate-400 leading-relaxed text-sm md:text-base">
                    <p>
                        Op de middelbare school heb ik in havo 4 en havo 5 het vak informatica gevolgd.
                        Hier heb ik al met meerdere programmeertalen gewerkt, en dit beviel mij altijd erg goed.
                    </p>
                    <p>
                        Ook vond ik deze lessen altijd erg leuk. Dit is een van de redenen waarom ik voor deze
                        studie heb gekozen. 2 jaar geleden heb ik dan ook al een website gemaakt, die over hacken ging.
                    </p>
                    <p>
                        Ik denk dat ik zeker geschikt ben voor deze opleiding en dit werkveld, omdat het coderen
                        mij erg goed ligt.
                    </p>
                </div>

                <div>
                    <div class="relative group">
                        <div class="absolute -inset-1 bg-gradient-to-r from-cyan-500/20 to-blue-500/20 rounded-xl blur opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                        <img
                            src="/assets/images/hackenenzo.png"
                            alt="Website 'Hacken enzo'"
                            class="relative rounded-xl border border-slate-700 w-full shadow-xl"
                        >
                    </div>
                    <p class="mt-2 text-center font-mono-custom text-xs text-slate-600">hacken-enzo.jpg</p>
                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}
