{% extends "layouts/base.html.twig" %}

{% block title %}Nieuwe post{% endblock %}

{% block content %}
    <section>
        <h1>Nieuwe post</h1>

        <form action="/blog/create" method="POST">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            
            <label>Titel
                <input type="text" name="title" required>
            </label>

            <label>Slug
                <input type="text" name="slug" required>
            </label>

            <label>Preview
                <textarea name="preview" required></textarea>
            </label>

            <label>Content
                <textarea name="content" required></textarea>
            </label>

            <label>Status
                <select name="status">
                    <option value="draft">Draft</option>
                    <option value="published">Gepubliceerd</option>
                </select>
            </label>

            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase tracking-wide mb-1">
                    Datum van publiceren
                </label>
                <input type="text" id="publication-date" name="date" required
                        class="w-full border border-gray-300 px-3 py-3">
            </div>

            <button type="submit">Opslaan</button>
        </form>

        <a href="/blog/manage">← Terug</a>
    </section>


    <script>
        document.addEventListener("DOMContentLoaded", () => {

            flatpickr.localize(flatpickr.l10ns.nl);

            // Datum picker
            const datePicker = flatpickr("#publication-date", {
                dateFormat: "d-m-Y",
                minDate: "today",
                disableMobile: true,
                onChange: function(selectedDates) {
                    const selected = selectedDates[0];
                    const today = new Date();
                    const isToday = selected.toDateString() === today.toDateString();

                    // Only set mintime if its today
                    if (isToday) {
                        const currentTime = today.toLocaleTimeString("nl-NL", { hour: "2-digit", minute: "2-digit" });
                        startPicker.set("minTime", currentTime);
                    } else {
                        startPicker.set("minTime", "00:00");
                    }
                }
            });
        });
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/nl.js"></script>

{% endblock %}