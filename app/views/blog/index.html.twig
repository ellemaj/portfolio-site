{% extends "layouts/base.html.twig" %}

{% block title %}Blog{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/css/blogposts.css">
{% endblock %}

{% block content %}
    <section class="feed">
        {% for post in posts %}
            <a href="/blog/{{ post.slug }}" class="post-card-link">
                <article class="post-card">
                    <h2>{{ post.title }}</h2>
                    <time>{{ post.created_at }}</time>
                    <p>{{ post.preview }}</p>
                </article>
            </a>
        {% endfor %}
    </section>

{% endblock %}