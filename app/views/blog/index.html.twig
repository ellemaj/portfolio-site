{% extends 'layouts/base.html.twig' %}

{% block title %}Blog{% endblock %}

{% block content %}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Header -->
    <div class="mb-10">
        <div class="font-mono-custom text-xs text-cyan-500 tracking-widest uppercase flex items-center gap-2 mb-2">
            <span class="inline-block w-6 h-px bg-cyan-500/50"></span>
            <span>Writing</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-slate-100">Blog</h1>
        <p class="mt-2 text-slate-400 text-sm">Artikelen over development, technologie, en meer.</p>
    </div>

    <!-- Loading state -->
    <div id="loading" class="flex items-center gap-3 text-slate-500 py-8">
        <svg class="w-4 h-4 animate-spin text-cyan-500" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
        </svg>
        <span class="text-sm font-mono-custom">Laden...</span>
    </div>

    <!-- Posts grid -->
    <div id="posts-container" class="grid sm:grid-cols-2 gap-5"></div>

</div>

<script>
    const postsContainer = document.getElementById('posts-container');
    const loading = document.getElementById('loading');
    const isAdmin = {{ auth.isAdmin ? 'true' : 'false' }};

    fetch('/api/posts')
        .then(response => {
            if (!response.ok) throw new Error('Fout bij ophalen posts');
            return response.json();
        })
        .then(posts => {
            loading.style.display = 'none';

            if (posts.length === 0) {
                postsContainer.innerHTML = `
                    <div class="sm:col-span-2 text-center py-16 text-slate-500">
                        <p class="font-mono-custom text-sm">// Geen posts gevonden</p>
                    </div>
                `;
                return;
            }

            posts.forEach(post => {
                const dateStr = new Date(post.publication_date * 1000).toLocaleDateString('nl-NL', {
                    day: 'numeric', month: 'long', year: 'numeric'
                });

                const card = document.createElement('div');
                card.className = 'group bg-slate-800/40 border border-slate-700/60 rounded-xl overflow-hidden hover:border-slate-600 transition-colors';

                card.innerHTML = `
                    <a href="/blog/${post.slug}" class="block p-6">
                        <div class="flex items-center gap-2 mb-3">
                            <span class="font-mono-custom text-xs text-slate-600">#</span>
                            <time class="font-mono-custom text-xs text-slate-500">${dateStr}</time>
                        </div>
                        <h2 class="text-lg font-semibold text-slate-100 group-hover:text-cyan-400 transition-colors mb-2 leading-snug">${post.title}</h2>
                        <p class="text-slate-400 text-sm leading-relaxed line-clamp-3">${post.preview}</p>
                        <div class="mt-4 flex items-center gap-1 text-cyan-500 text-xs font-mono-custom group-hover:gap-2 transition-all">
                            <span>Lees meer</span>
                            <span>→</span>
                        </div>
                    </a>
                    ${isAdmin ? `
                        <div class="px-6 py-3 border-t border-slate-700/40 bg-slate-800/60">
                            <a href="/blog/${post.id}/edit"
                               class="text-xs font-mono-custom text-amber-500 hover:text-amber-400 transition-colors">
                                ✎ Bewerken
                            </a>
                        </div>
                    ` : ''}
                `;

                postsContainer.appendChild(card);
            });

            if (isAdmin) {
                const adminCard = document.createElement('div');
                adminCard.className = 'sm:col-span-2 pt-4 border-t border-slate-800';
                adminCard.innerHTML = `
                    <a href="/blog/manage"
                       class="inline-flex items-center gap-2 px-4 py-2 bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 text-amber-400 rounded-lg text-sm font-medium transition-colors font-mono-custom">
                        ⚙ Beheer overzicht
                    </a>
                `;
                postsContainer.appendChild(adminCard);
            }
        })
        .catch(error => {
            loading.innerHTML = `
                <div class="flex items-center gap-2 text-red-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span class="text-sm font-mono-custom">Er ging iets mis: ${error.message}</span>
                </div>
            `;
        });
</script>

{% endblock %}
