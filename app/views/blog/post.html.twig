{% extends "layouts/base.html.twig" %}

{% block title %}{{ post.title }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/assets/css/blogposts.css">
{% endblock %}

{% block content %}
    <section>
        <div>
            <h2>{{ post.title }}<h2>
        </div>
        <div>
            <h3><time>{{ post.publication_date|nldate }}</time><h3>
        </div>
        <div>
            {{ post.content|raw }}
        </div>

        <h4><a href="/blog" class="terug-knop">← Terug naar blog</a></h4>
    </section>

{% endblock %}