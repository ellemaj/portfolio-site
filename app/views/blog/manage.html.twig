{% extends "layouts/base.html.twig" %}

{% block title %}Posts beheren{% endblock %}

{% block content %}
    <section>
        <h1>Posts beheren</h1>
        <a href="/blog/create">Nieuwe post</a>

        <table>
            <thead>
                <tr>
                    <th>Titel</th>
                    <th>Slug</th>
                    <th>Status</th>
                    <th>Acties</th>
                </tr>
            </thead>
            <tbody>
                {% for post in posts %}
                    <tr>
                        <td>{{ post.title }}</td>
                        <td>{{ post.slug }}</td>
                        <td>{{ post.status }}</td>
                        <td>
                            <a href="/blog/{{ post.id }}/edit">Bewerken</a>

                            {% if post.deleted_at is not null and post.deleted_at > date().timestamp %}
                            
                                <form action="/blog/{{ post.id }}/restore" method="POST">
                                    <button type="submit">Ongedaan maken</button>
                                </form>
                            {% else %}
                                <form action="/blog/{{ post.id }}/delete" method="POST">
                                    <button type="submit">Verwijderen</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
{% endblock %}