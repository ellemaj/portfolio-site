{% extends "layouts/base.html.twig" %}

{% block title %}Dashboard{% endblock %}

{% block scripts %}
<script src="/assets/js/dashboard.js"></script>
{% endblock %}

{% block content %}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <div class="flex flex-col lg:flex-row gap-8">

        <!-- Sidebar -->
        <aside class="w-full lg:w-64 flex-shrink-0">
            <div class="bg-slate-800/40 border border-slate-700/60 rounded-xl p-5 sticky top-20">
                <p class="font-mono-custom text-xs text-cyan-500 uppercase tracking-widest mb-4">Handige links</p>
                <ul class="space-y-1">
                    <li>
                        <a href="https://oer.hz.nl/9b1081fb-c060-4091-bb2b-ae39ccf8456a" target="_blank"
                           class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-slate-100 hover:bg-slate-700/60 transition-colors group">
                            <span class="font-mono-custom text-cyan-600 text-xs group-hover:text-cyan-400">→</span>
                            HBO-ICT CER
                        </a>
                    </li>
                    <li>
                        <a href="https://oer.hz.nl/93eee6aa-2bc1-454c-a56a-f8b56c62ba9f" target="_blank"
                           class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-slate-100 hover:bg-slate-700/60 transition-colors group">
                            <span class="font-mono-custom text-cyan-600 text-xs group-hover:text-cyan-400">→</span>
                            HBO-ICT IR
                        </a>
                    </li>
                    <li>
                        <a href="https://learn.hz.nl/course/view.php?id=23602#section-0" target="_blank"
                           class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-slate-100 hover:bg-slate-700/60 transition-colors group">
                            <span class="font-mono-custom text-cyan-600 text-xs group-hover:text-cyan-400">→</span>
                            Learn - PCO
                        </a>
                    </li>
                    <li>
                        <a href="https://hz.osiris-student.nl/voortgang" target="_blank"
                           class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-slate-100 hover:bg-slate-700/60 transition-colors group">
                            <span class="font-mono-custom text-cyan-600 text-xs group-hover:text-cyan-400">→</span>
                            Study Progress
                        </a>
                    </li>
                    <li>
                        <a href="https://github.com/HZ-HBO-ICT" target="_blank"
                           class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-slate-100 hover:bg-slate-700/60 transition-colors group">
                            <span class="font-mono-custom text-cyan-600 text-xs group-hover:text-cyan-400">→</span>
                            GitHub HBO-ICT
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <!-- Main content -->
        <div class="flex-1 min-w-0 space-y-8">

            <!-- Header -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <div class="font-mono-custom text-xs text-cyan-500 tracking-widest uppercase flex items-center gap-2 mb-1">
                        <span class="inline-block w-4 h-px bg-cyan-500/50"></span>
                        <span>Year 1</span>
                    </div>
                    <h1 class="text-3xl font-bold text-slate-100">Dashboard</h1>
                </div>
                <a href="https://hz.nl" target="_blank">
                    <img src="/assets/images/hzlogo_groot.png" alt="HZ logo" class="h-10 opacity-70 hover:opacity-100 transition-opacity">
                </a>
            </div>

            <!-- Progress card -->
            <div class="bg-slate-800/40 border border-slate-700/60 rounded-xl p-6">
                <div class="flex items-center justify-between mb-3">
                    <p class="font-mono-custom text-xs text-cyan-500 uppercase tracking-widest">Studiepunten voortgang</p>
                    <span class="font-mono-custom text-sm font-semibold text-slate-300">{{ earned }} / {{ total }} EC</span>
                </div>
                <div class="w-full bg-slate-700/60 rounded-full h-2.5 overflow-hidden">
                    <div class="h-full rounded-full bg-gradient-to-r from-cyan-500 to-blue-500 transition-all duration-700"
                         style="width: {{ (earned / total * 100)|round }}%"></div>
                </div>
                <p class="mt-2 text-right font-mono-custom text-xs text-slate-500">{{ (earned / total * 100)|round }}% behaald</p>
            </div>

            <!-- Grades table -->
            <div class="bg-slate-800/40 border border-slate-700/60 rounded-xl overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-700/60 flex items-center gap-3">
                    <div class="flex gap-1.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-red-500/60"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-green-500/60"></span>
                    </div>
                    <span class="font-mono-custom text-xs text-slate-500">overzicht-jaar-1.csv</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-slate-700/60">
                                <th class="px-4 py-3 text-left font-mono-custom text-xs text-slate-500 uppercase tracking-wider">Blok</th>
                                <th class="px-4 py-3 text-left font-mono-custom text-xs text-slate-500 uppercase tracking-wider">Vak</th>
                                <th class="px-4 py-3 text-center font-mono-custom text-xs text-slate-500 uppercase tracking-wider">EC</th>
                                <th class="px-4 py-3 text-left font-mono-custom text-xs text-slate-500 uppercase tracking-wider">Examen</th>
                                <th class="px-4 py-3 text-center font-mono-custom text-xs text-slate-500 uppercase tracking-wider">Cijfer</th>
                                {% if session.role == 'admin' %}
                                    <th class="px-4 py-3 text-center font-mono-custom text-xs text-slate-500 uppercase tracking-wider">Aanpassen</th>
                                {% endif %}
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-700/40">
                            {% for course in courses %}
                                <tr class="hover:bg-slate-700/20 transition-colors {% if course.grade is null %}opacity-60{% endif %}">
                                    <td class="px-4 py-3 font-mono-custom text-xs text-slate-400">{{ course.blok }}</td>
                                    <td class="px-4 py-3 text-slate-200 font-medium">{{ course.name }}</td>
                                    <td class="px-4 py-3 text-center">
                                        <span class="font-mono-custom text-xs text-slate-400">{{ course.ec }}</span>
                                    </td>
                                    <td class="px-4 py-3 text-slate-400 text-xs">{{ course.exam_type }}</td>
                                    <td class="px-4 py-3 text-center">
                                        {% if course.grade is not null %}
                                            <span class="font-mono-custom font-semibold text-sm
                                                {% if course.grade >= 5.5 %}text-emerald-400{% else %}text-red-400{% endif %}">
                                                {{ course.grade }}
                                            </span>
                                        {% else %}
                                            <span class="font-mono-custom text-slate-600">—</span>
                                        {% endif %}
                                    </td>
                                    {% if session.role == 'admin' %}
                                        <td class="px-4 py-3">
                                            <form action="/dashboard/grade/update" method="POST" class="flex items-center gap-2 justify-center">
                                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                                <input type="hidden" name="id" value="{{ course.id }}">
                                                <input type="number" name="grade" step="0.1" min="1" max="10"
                                                       value="{{ course.grade ?? '' }}" placeholder="—"
                                                       class="w-16 px-2 py-1 bg-slate-700/60 border border-slate-600 text-slate-200 rounded-md text-xs font-mono-custom text-center focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30">
                                                <button type="submit"
                                                        class="px-2.5 py-1 bg-cyan-600/20 hover:bg-cyan-600/40 border border-cyan-600/40 text-cyan-400 rounded-md text-xs font-medium transition-colors">
                                                    Save
                                                </button>
                                            </form>
                                        </td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

{% endblock %}
