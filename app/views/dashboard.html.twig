{% extends "layouts/base.html.twig" %}

{% block title %}Dashboard{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/css/dashboard.css">
{% endblock %}

{% block scripts %}
<script src="/js/dashboard.js"></script>
{% endblock %}

{% block content %}
<aside class="side_menu">
    <h3>Handige links</h3>
    <ul>
        <li><a href="https://oer.hz.nl/9b1081fb-c060-4091-bb2b-ae39ccf8456a" target="_blank">HBO-ICT CER</a></li>
        <li><a href="https://oer.hz.nl/93eee6aa-2bc1-454c-a56a-f8b56c62ba9f" target="_blank">HBO-ICT IR</a></li>
        <li><a href="https://learn.hz.nl/course/view.php?id=23602#section-0" target="_blank">Learn - PCO</a></li>
        <li><a href="https://hz.osiris-student.nl/voortgang" target="_blank">Study Progress (Osiris)</a></li>
        <li><a href="https://github.com/HZ-HBO-ICT" target="_blank">GitHub-omgeving HBO-ICT</a></li>
    </ul>
</aside>

<section class="dashboard-layout">
    <section class="dashboard_section">
        <h1>Dashboard</h1>

        <a href="https://hz.nl" target="_blank">
            <img src="/images/hzlogo_groot.png" width="300" alt="HZ logo">
        </a>

        <h2>Overzicht van jaar 1:</h2>

        <table>
            <tr>
                <th>Blok</th>
                <th>Vakken</th>
                <th>EC</th>
                <th>Examen</th>
                <th>Cijfer</th>
                {% if session.role == 'admin' %}
                    <th>Aanpassen</th>
                {% endif %}
            </tr>

            {% for course in courses %}
                <tr class="{% if course.grade is null %}bezig{% endif %}">
                    <td>{{ course.blok }}</td>
                    <td>{{ course.name }}</td>
                    <td class="ec">{{ course.ec }}</td>
                    <td>{{ course.exam_type }}</td>
                    <td class="grade">
                        {% if course.grade is not null %}
                            {{ course.grade }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    {% if session.role == 'admin' %}
                        <td>
                            <form action="/dashboard/grade/update" method="POST">
                                <input type="hidden" name="id" value="{{ course.id }}">
                                <input type="number" name="grade" step="0.1" min="1" max="10"
                                       value="{{ course.grade ?? '' }}" placeholder="-">
                                <button type="submit">Opslaan</button>
                            </form>
                        </td>
                    {% endif %}
                </tr>
            {% endfor %}
        </table>

        <h2>Voortgang studiepunten:</h2>
        <div class="progress-bar">
            <div class="progress" style="width: {{ (earned / total * 100)|round }}%"></div>
        </div>
        <p>{{ earned }} / {{ total }} EC behaald</p>
    </section>
</section>
{% endblock %}