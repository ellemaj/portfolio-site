{% extends "layouts/base.html.twig" %}

{% block title %}Register{% endblock %}

{% block content %}

<div class="min-h-[calc(100vh-3.5rem)] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-sm">

        <!-- Brand -->
        <div class="text-center mb-8">
            <span class="font-mono-custom text-2xl font-semibold">
                <span class="text-slate-600">&lt;</span><span class="text-cyan-400">ellemaj</span><span class="text-slate-600">/&gt;</span>
            </span>
            <h1 class="mt-4 text-2xl font-bold text-slate-100">Account aanmaken</h1>
            <p class="mt-1 text-sm text-slate-500">Maak een account aan om toegang te krijgen tot extra functies.</p>
        </div>

        <!-- Card -->
        <div class="bg-slate-800/50 border border-slate-700/60 rounded-2xl p-7">
            <form method="POST" action="/register" id="register-form" novalidate class="space-y-4">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

                <!-- First name -->
                <div>
                    <label for="firstName" class="block text-xs font-mono-custom text-slate-400 uppercase tracking-wider mb-1.5">Voornaam</label>
                    <input
                        type="text"
                        id="firstName"
                        name="firstName"
                        placeholder="Elmar"
                        autocomplete="given-name"
                        required
                        class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 placeholder-slate-600 rounded-lg text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors"
                    >
                    <p class="field-error hidden mt-1.5 text-xs text-red-400 font-mono-custom" id="firstName-error">Voornaam is verplicht.</p>
                </div>

                <!-- Last name -->
                <div>
                    <label for="lastName" class="block text-xs font-mono-custom text-slate-400 uppercase tracking-wider mb-1.5">Achternaam</label>
                    <input
                        type="text"
                        id="lastName"
                        name="lastName"
                        placeholder="van Loenhout"
                        autocomplete="family-name"
                        required
                        class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 placeholder-slate-600 rounded-lg text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors"
                    >
                    <p class="field-error hidden mt-1.5 text-xs text-red-400 font-mono-custom" id="lastName-error">Achternaam is verplicht.</p>
                </div>

                <!-- Email -->
                <div>
                    <label for="email" class="block text-xs font-mono-custom text-slate-400 uppercase tracking-wider mb-1.5">Email</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="jou@email.nl"
                        autocomplete="email"
                        required
                        class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 placeholder-slate-600 rounded-lg text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors"
                    >
                    <p class="field-error hidden mt-1.5 text-xs text-red-400 font-mono-custom" id="email-error">Voer een geldig e-mailadres in.</p>
                </div>

                <!-- Password -->
                <div>
                    <label for="password" class="block text-xs font-mono-custom text-slate-400 uppercase tracking-wider mb-1.5">Wachtwoord</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="••••••••"
                        autocomplete="new-password"
                        minlength="8"
                        required
                        class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 placeholder-slate-600 rounded-lg text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors"
                    >
                    <p class="mt-1 text-xs text-slate-600 font-mono-custom">Minimaal 8 tekens.</p>
                    <p class="field-error hidden mt-1 text-xs text-red-400 font-mono-custom" id="password-error">Wachtwoord moet minimaal 8 tekens zijn.</p>
                </div>

                <!-- Confirm password -->
                <div>
                    <label for="password_confirm" class="block text-xs font-mono-custom text-slate-400 uppercase tracking-wider mb-1.5">Wachtwoord bevestigen</label>
                    <input
                        type="password"
                        id="password_confirm"
                        name="password_confirm"
                        placeholder="••••••••"
                        autocomplete="new-password"
                        minlength="8"
                        required
                        class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 placeholder-slate-600 rounded-lg text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors"
                    >
                    <p class="field-error hidden mt-1.5 text-xs text-red-400 font-mono-custom" id="password-confirm-error">Wachtwoorden komen niet overeen.</p>
                </div>

                <!-- Submit -->
                <button
                    type="submit"
                    class="w-full mt-2 px-4 py-2.5 bg-cyan-500 hover:bg-cyan-400 disabled:opacity-50 text-slate-950 font-semibold rounded-lg text-sm transition-colors font-mono-custom"
                >
                    Account aanmaken →
                </button>
            </form>
        </div>

        <!-- Login link -->
        <p class="mt-5 text-center text-sm text-slate-500">
            Heb je al een account?
            <a href="/login" class="text-cyan-400 hover:text-cyan-300 transition-colors">Login hier</a>
        </p>

    </div>
</div>

<style>
    .input-invalid { border-color: rgb(248 113 113) !important; }
</style>

<script>
    const form = document.getElementById('register-form');

    function showError(inputId, errorId) {
        document.getElementById(inputId).classList.add('input-invalid');
        document.getElementById(errorId).classList.remove('hidden');
    }

    function clearError(inputId, errorId) {
        document.getElementById(inputId).classList.remove('input-invalid');
        document.getElementById(errorId).classList.add('hidden');
    }

    ['firstName', 'lastName'].forEach(id => {
        const input = document.getElementById(id);
        input.addEventListener('blur', () => {
            if (!input.value.trim()) showError(id, id + '-error');
        });
        input.addEventListener('input', () => clearError(id, id + '-error'));
    });

    const emailInput = document.getElementById('email');
    emailInput.addEventListener('blur', () => {
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value)) showError('email', 'email-error');
    });
    emailInput.addEventListener('input', () => clearError('email', 'email-error'));

    const passwordInput = document.getElementById('password');
    passwordInput.addEventListener('blur', () => {
        if (passwordInput.value.length < 8) showError('password', 'password-error');
    });
    passwordInput.addEventListener('input', () => clearError('password', 'password-error'));

    const confirmInput = document.getElementById('password_confirm');
    confirmInput.addEventListener('blur', () => {
        if (confirmInput.value !== passwordInput.value) showError('password_confirm', 'password-confirm-error');
    });
    confirmInput.addEventListener('input', () => clearError('password_confirm', 'password-confirm-error'));

    form.addEventListener('submit', (e) => {
        let hasError = false;

        if (!document.getElementById('firstName').value.trim()) { showError('firstName', 'firstName-error'); hasError = true; }
        if (!document.getElementById('lastName').value.trim()) { showError('lastName', 'lastName-error'); hasError = true; }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value)) { showError('email', 'email-error'); hasError = true; }
        if (passwordInput.value.length < 8) { showError('password', 'password-error'); hasError = true; }
        if (confirmInput.value !== passwordInput.value) { showError('password_confirm', 'password-confirm-error'); hasError = true; }

        if (hasError) e.preventDefault();
    });
</script>

{% endblock %}
