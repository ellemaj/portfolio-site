{% extends "layouts/base.html.twig" %}

{% block title %}Register{% endblock %}

{% block content %}

<section style="max-width: 500px; margin: 40px auto; text-align: center;">

    <h1>Register</h1>

    <p>
        Maak een account aan om toegang te krijgen tot extra functies.
    </p>

    <form method="POST" action="/register">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        
        <p>
            <input
                type="text"
                name="username"
                placeholder="Username"
                required
                style="width: 90%; padding: 12px; border-radius: 6px; border: none;"
            >
        </p>

        <p>
            <input
                type="text"
                name="name"
                placeholder="Name"
                style="width: 90%; padding: 12px; border-radius: 6px; border: none;"
            >
        </p>

        <p>
            <input
                type="email"
                name="email"
                placeholder="Email"
                required
                style="width: 90%; padding: 12px; border-radius: 6px; border: none;"
            >
        </p>

        <p>
            <input
                type="password"
                name="password"
                placeholder="Password"
                required
                style="width: 90%; padding: 12px; border-radius: 6px; border: none;"
            >
        </p>

        <p>
            <button
                type="submit"
                style="padding: 12px 24px; border: none; border-radius: 6px; cursor: pointer;"
            >
                Register
            </button>
        </p>

    </form>

    <p>
        Heb je al een account?
        <a href="/login">Login hier</a>
    </p>

</section>

{% endblock %}