{% extends "layouts/base.html.twig" %}

{% block title %}Edit Profile{% endblock %}

{% block content %}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Header -->
    <div class="mb-8">
        <div class="font-mono-custom text-xs text-amber-500 tracking-widest uppercase flex items-center gap-2 mb-2">
            <span class="inline-block w-6 h-px bg-amber-500/50"></span>
            <span>Admin</span>
        </div>
        <h1 class="text-3xl font-bold text-slate-100">Edit Profile</h1>
    </div>

    <!-- Form card -->
    <div class="bg-slate-800/40 border border-slate-700/60 rounded-2xl overflow-hidden">

        <div class="px-6 py-4 border-b border-slate-700/60 flex items-center gap-3">
            <div class="flex gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-red-500/60"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-green-500/60"></span>
            </div>
            <span class="font-mono-custom text-xs text-slate-500">profile-update.php</span>
        </div>

        <form action="/profile/update" method="POST" class="p-6 space-y-5">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            <!-- Intro -->
            <div>
                <label class="block text-xs font-mono-custom text-slate-400 uppercase tracking-wider mb-1.5">Intro</label>
                <textarea name="intro" rows="2"
                          class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 placeholder-slate-600 rounded-lg text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors resize-y">{{ profile.intro }}</textarea>
            </div>

            <!-- Biography -->
            <div>
                <label class="block text-xs font-mono-custom text-slate-400 uppercase tracking-wider mb-1.5">Biography</label>
                <textarea name="bio" rows="4"
                          class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 placeholder-slate-600 rounded-lg text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors resize-y">{{ profile.bio }}</textarea>
            </div>

            <!-- Birthdate -->
            <div>
                <label class="block text-xs font-mono-custom text-slate-400 uppercase tracking-wider mb-1.5">Birthdate</label>
                <input type="date" name="birthdate" value="{{ profile.birthdate }}"
                       class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 rounded-lg text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors">
            </div>

            <!-- 2-col grid: Education + Experience -->
            <div class="grid sm:grid-cols-2 gap-5">
                <div>
                    <label class="block text-xs font-mono-custom text-slate-400 uppercase tracking-wider mb-1.5">Education</label>
                    <input type="text" name="education" value="{{ profile.education }}"
                           class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 rounded-lg text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors">
                </div>
                <div>
                    <label class="block text-xs font-mono-custom text-slate-400 uppercase tracking-wider mb-1.5">Experience</label>
                    <textarea name="experience" rows="3"
                              class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 rounded-lg text-sm focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors resize-y">{{ profile.experience }}</textarea>
                </div>
            </div>

            <!-- Skills + Traits -->
            <div class="grid sm:grid-cols-2 gap-5">
                <div>
                    <label class="block text-xs font-mono-custom text-slate-400 uppercase tracking-wider mb-1.5">Skills <span class="text-slate-600 normal-case">(1 per regel)</span></label>
                    <textarea name="skills" rows="6"
                              class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 rounded-lg text-sm font-mono-custom focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors resize-y">{{ skills|join('\n') }}</textarea>
                </div>
                <div>
                    <label class="block text-xs font-mono-custom text-slate-400 uppercase tracking-wider mb-1.5">Traits <span class="text-slate-600 normal-case">(1 per regel)</span></label>
                    <textarea name="traits" rows="6"
                              class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 rounded-lg text-sm font-mono-custom focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors resize-y">{{ traits|join('\n') }}</textarea>
                </div>
            </div>

            <!-- Social links -->
            <div>
                <p class="text-xs font-mono-custom text-slate-500 uppercase tracking-wider mb-3">Social Links</p>
                <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-mono-custom text-slate-500 mb-1.5">GitHub URL</label>
                        <input type="text" name="github" value="{{ profile.github }}"
                               class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 rounded-lg text-sm font-mono-custom focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors">
                    </div>
                    <div>
                        <label class="block text-xs font-mono-custom text-slate-500 mb-1.5">LinkedIn URL</label>
                        <input type="text" name="linkedin" value="{{ profile.linkedin }}"
                               class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 rounded-lg text-sm font-mono-custom focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors">
                    </div>
                    <div>
                        <label class="block text-xs font-mono-custom text-slate-500 mb-1.5">Spotify URL</label>
                        <input type="text" name="spotify" value="{{ profile.spotify }}"
                               class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 rounded-lg text-sm font-mono-custom focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors">
                    </div>
                    <div>
                        <label class="block text-xs font-mono-custom text-slate-500 mb-1.5">Discord URL</label>
                        <input type="text" name="discord" value="{{ profile.discord }}"
                               class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 rounded-lg text-sm font-mono-custom focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors">
                    </div>
                </div>
            </div>

            <!-- Profile image -->
            <div>
                <label class="block text-xs font-mono-custom text-slate-400 uppercase tracking-wider mb-1.5">Profile Image Path</label>
                <input type="text" name="image" value="{{ profile.image }}"
                       class="w-full px-4 py-2.5 bg-slate-700/50 border border-slate-600/60 text-slate-200 rounded-lg text-sm font-mono-custom focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500/30 transition-colors"
                       placeholder="/assets/images/profile.jpg">
            </div>

            <!-- Submit -->
            <div class="pt-2 flex items-center gap-3">
                <button type="submit"
                        class="px-6 py-2.5 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold rounded-lg text-sm transition-colors font-mono-custom">
                    Save Profile
                </button>
                <a href="/profile" class="text-sm text-slate-500 hover:text-slate-300 transition-colors">Cancel</a>
            </div>

        </form>
    </div>

</div>

{% endblock %}
