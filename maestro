<?php

require __DIR__ . '/vendor/autoload.php';

use Framework\Kernel;

if ($argv[1] === 'serve') {
    exec('php -S 0.0.0.0:8080 -t public');
}

if ($argv[1] === 'phpstan') {
    passthru('php vendor/bin/phpstan --ansi');
}

if ($argv[1] === 'phpcs') {
    passthru('php vendor/bin/phpcs --colors');
}

if ($argv[1] === 'deptrac') {
    passthru('php vendor/bin/deptrac --ansi');
}

if ($argv[1] === 'migrate') {
    $isMySQL = isset($_ENV['DB_HOST']);
    $dir = $isMySQL ? __DIR__ . '/database/mysql/' : __DIR__ . '/database/';
    $dbPath = $isMySQL ? '' : __DIR__ . '/database.sqlite';

    $kernel = new Kernel([
        'APP_ENV' => 'development',
        'VIEWS_PATH' => './app/views',
        'APP_DB' => $dbPath
    ]);

    $kernel->getDatabase()->migrate($dir);
}